APP_ENV=dev
# true uniquement en local : en démonstration ou en production, laisser false
# (sinon les pages d'erreur révèlent des détails techniques).
APP_DEBUG=false

DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bts_web
# Utiliser un compte dédié à l'application plutôt que root dès que possible.
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
